#!/bin/bash

# arguments example:
# matroska 256 /home/username/video.mkv /tmp/tumbler-MCYFW2.png file:///home/username/video.mkv

set -e
set -o pipefail
set -u

typename=$1
tn_size=$2
file_path=$3
thumbnail_path=$4
file_uri=$5

mkv_info_json() { mkvmerge --identify  --identification-format json "$1"; }
json_find_cover_picture_attachment_id() { jq -r '[.attachments[] | select((.file_name | match("^(small_|)cover")) and (.content_type | match("^image")))] | .[0].id'; }

case "$typename" in
(matroska)
	for dependency in mkvmerge jq mkvextract convert
	do
		type "$dependency" >/dev/null
	done
	
	cover_pic_aid=`mkv_info_json "$file_path" | json_find_cover_picture_attachment_id`
	mkvextract -q "$file_path" attachments "$cover_pic_aid:/dev/stdout" | convert - "$thumbnail_path" >&2
	;;
(mp4)
	exiftool -b -CoverArt "$file_path" | convert - "$thumbnail_path" >&2
	;;
(*)
	echo "$0: not yet supported: $typename" >&2
	exit 1
	;;
esac


if [ ! -s "$thumbnail_path" ]
then
	# clear the old thumbnail from cache if we could not generate a new one
	gdbus call --session --dest=org.freedesktop.thumbnails.Cache1 --object-path /org/freedesktop/thumbnails/Cache1 \
		--method org.freedesktop.thumbnails.Cache1.Delete "['$file_uri']" >&2
fi

